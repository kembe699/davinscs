# FlippedPOS offline install — copy this file to ".env" and edit it.
#   Windows:  copy .env.docker.example .env
#   Linux:    cp .env.docker.example .env
# start.bat does this for you on first run.
#
# Only what an on-premise install needs. .env.example is the full reference for
# every setting the app understands, including cloud-only ones.

# ─── App ──────────────────────────────────────────────────────────────────────
# Port on THIS PC. Change it if something else already uses 3001.
APP_PORT=3001
# The address staff will type. Use the PC's LAN IP if other tills connect to it,
# e.g. http://192.168.1.50:3001
APP_URL=http://localhost:3001

# ─── Security ─────────────────────────────────────────────────────────────────
# REQUIRED. The stack refuses to start without it, on purpose: the previous
# default was a shared placeholder, and anyone who knew it could mint valid
# logins for any install that kept it. Generate a fresh one per install:
#   powershell -Command "[guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')"
JWT_SECRET=

# ─── Database ─────────────────────────────────────────────────────────────────
# Runs in a container on this PC; nothing else can reach it. Change the password
# anyway if this machine is shared.
DB_NAME=flippedpos
DB_USER=flippedpos
DB_PASSWORD=flippedpos123

# ─── Licence sync ─────────────────────────────────────────────────────────────
# Where this install checks its licence and pulls the shop's account from. It
# must be reachable on first login and roughly every 6 hours after that; the POS
# keeps working between checks.
MASTER_API_URL=https://davinscs.onrender.com

# ─── Email (optional) ─────────────────────────────────────────────────────────
# Leave blank offline. Email is skipped and everything else runs normally.
RESEND_API_KEY=
EMAIL_FROM=
