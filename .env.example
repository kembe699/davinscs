# ── LOCAL DOCKER (docker-compose) ─────────────────────────────────────────
# These values are already set in docker-compose.yml — only needed if you
# run the server directly without Docker.
#
# DATABASE_URL=postgres://flippedpos:flippedpos123@localhost:5432/flippedpos
# JWT_SECRET=change-me-to-a-strong-secret-min-32-chars!!
# NODE_ENV=production
# PORT=3001
# APP_URL=http://localhost:3001
# DB_SSL=false

# ── RENDER / CLOUD DEPLOYMENT ─────────────────────────────────────────────
# PostgreSQL connection string (from Render / Supabase / etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret key for signing JWT tokens (use a long random string)
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars

# Set to "production" on your server
NODE_ENV=production

# Port the Express server listens on (Render sets this automatically)
PORT=10000

# Email Configuration (Resend — used for welcome emails, password reset, billing notices)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=FlippedPOS <notifications@flippedpos.com>
ADMIN_EMAIL=admin@yourstore.com
APP_URL=https://your-app.onrender.com

# Disable SSL for local postgres (set to "false" for Docker, leave unset for Render)
# DB_SSL=false

# Offline Mode Configuration
OFFLINE_MODE=false
VITE_OFFLINE_MODE=false
MASTER_API_URL=https://davinscs.onrender.com

# PesaPal Payments Configuration
PESAPAL_CONSUMER_KEY=SXdCIHdln/XoINOmc6lKCB0NcJWppyxS
PESAPAL_CONSUMER_SECRET=cdG2KBoa2xV46er0MQfgeY/XIXQ=
PESAPAL_IPN_ID=
UGX_RATE=3700
APP_BASE_URL=https://app.flippedpos.com
FRONTEND_URL=https://flippedpos.com

# Firebase Admin SDK — push notifications for the admin mobile app.
# Paste the ENTIRE service account JSON (Firebase console → Project Settings →
# Service Accounts → Generate new private key) as a single-line string here.
# Push notifications are silently disabled (in-app notification feed still
# works) if this is left unset.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
