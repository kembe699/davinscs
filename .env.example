# Copy this to .env and fill in your values

# PostgreSQL connection string (from Render / Supabase / etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret key for signing JWT tokens (use a long random string)
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars

# Set to "production" on your server
NODE_ENV=production

# Port the Express server listens on (Render sets this automatically)
PORT=10000

# Email Configuration (for password reset and order notifications)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ADMIN_EMAIL=admin@divinsstore.com
APP_URL=https://davinscs.onrender.com

# Only needed for local Vite dev (vite proxy handles this in dev)
# VITE_API_URL=http://localhost:3001
